# ============================================================
# CourseMate · 智能体服务环境变量示例
#
# 用法：复制本文件为 .env，把值改成自己的。
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
#
# ⚠️ .env 已被 .gitignore 屏蔽，绝对不要提交到仓库。
# ============================================================

# -------------------- 大模型 --------------------
# DeepSeek / 通义千问 都提供 OpenAI 兼容接口，改 base_url + model 即可切换
LLM_API_KEY=sk-your-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# -------------------- ReAct 循环参数 --------------------
# 最大思考轮次，防止工具被无限调用（对应项目文档里的"防死循环"设计）
MAX_REACT_STEPS=8
# 单次对话总超时（秒）
AGENT_TIMEOUT_SECONDS=120

# -------------------- 服务 --------------------
APP_ENV=dev
LOG_LEVEL=INFO
