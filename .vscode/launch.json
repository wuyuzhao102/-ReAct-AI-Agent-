{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🐍 Agent 服务 (FastAPI :8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/agent",
      "python": "${workspaceFolder}/agent/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "🧪 运行全部测试 (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}/agent",
      "python": "${workspaceFolder}/agent/.venv/Scripts/python.exe",
      "console": "integratedTerminal"
    }
  ]
}
