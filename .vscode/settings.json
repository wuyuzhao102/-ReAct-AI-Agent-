{
  // ===== 所有人共用，不要写自己电脑的绝对路径 =====
  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // ===== Python（智能体模块）=====
  "python.defaultInterpreterPath": "${workspaceFolder}/agent/.venv/Scripts/python.exe",
  "python.terminal.activateEnvironment": true,
  "python.analysis.extraPaths": ["${workspaceFolder}/agent"],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}/agent",
  "python.testing.pytestArgs": ["tests"],

  // ===== 编辑器体验 =====
  "[python]": {
    "editor.tabSize": 4,
    "editor.rulers": [100]
  },
  "[javascript]": { "editor.tabSize": 2 },
  "[vue]": { "editor.tabSize": 2 },
  "[java]": { "editor.tabSize": 4 },
  "[markdown]": {
    "editor.wordWrap": "on",
    "editor.quickSuggestions": { "other": false, "comments": false, "strings": false }
  },
  "markdown.preview.breaks": true,

  // ===== 资源管理器瘦身：这些目录不用显示 =====
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.venv": true,
    "**/node_modules": true,
    "**/target": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/target": true,
    "**/.venv": true,
    "**/dist": true
  }
}
